# ---- OmniPilot AI environment variables ----
# Copy this file to ".env" and fill in your values.

# API authentication (optional — leave empty to disable auth in dev mode)
OMNIPILOT_API_KEY=

# LLM provider — Google Gemini via Vertex AI (service-account auth).
# 1. In GCP: create a service account with the "Vertex AI User" role and download the JSON key.
# 2. Place the JSON key at the repo root (e.g. gcp-key.json — gitignored, never commit).
# 3. Point GOOGLE_APPLICATION_CREDENTIALS at that file (path may be relative or absolute).
GOOGLE_APPLICATION_CREDENTIALS=./gcp-key.json
GOOGLE_CLOUD_PROJECT=your_gcp_project_id
GOOGLE_CLOUD_LOCATION=us-central1

# Web search
TAVILY_API_KEY=your_tavily_api_key_here

# Calendar integration (Phase 2 - Cal.com)
CALCOM_API_KEY=your_calcom_api_key_here
CALCOM_API_BASE=https://api.cal.com/v2
CALCOM_EVENT_SLUGS=15min,30min
CALCOM_ATTENDEE_EMAIL=your_email@example.com
CALCOM_ATTENDEE_TIMEZONE=Asia/Kolkata

# Database (matches docker-compose.yml: pgvector on host port 5433)
DATABASE_URL=postgresql+asyncpg://omnipilot:omnipilot_pass@localhost:5433/omnipilot_db
POSTGRES_USER=omnipilot
POSTGRES_PASSWORD=omnipilot_pass
POSTGRES_DB=omnipilot_db

# Ollama embeddings endpoint (local; default port 11434)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_EMBED_MODEL=nomic-embed-text

# HITL interrupt gates — comma-separated list of agent nodes that require
# human approval before executing. Default: calendar
# Set to "calendar,browser,research" to gate all side-effecting agents.
HITL_INTERRUPT_NODES=calendar

# Proactive daily briefing — runs on this schedule and delivers a summary of
# the day's Cal.com events as a new session. Defaults: 7:00 AM in
# CALCOM_ATTENDEE_TIMEZONE (or UTC if that's unset too).
DAILY_BRIEFING_HOUR=7
DAILY_BRIEFING_MINUTE=0
DAILY_BRIEFING_TIMEZONE=
